---
// import SvgItGirlEn from "../svg/SvgItGirlEn.astro"; // adesivo nascosto su richiesta cliente
// import SvgPinkArrowFlat from "../svg/SvgPinkArrowFlat.astro"; // adesivo nascosto su richiesta cliente

// Locale & translations
const currentLocale = Astro.currentLocale || "it";
const translations = await import(`../../i18n/${currentLocale}.json`);
const t = translations.default;
---

<section class="manifesto-section">
  <div class="content-container">
    <!-- Adesivi nascosti su richiesta cliente (svg-desktop / svg-mobile) -->
    {
      t.manifestoSection.title && (
        <h2 class="manifesto-title" set:html={t.manifestoSection.title}></h2>
      )
    }
    {
      t.manifestoSection.subtitle && (
        <p class="manifesto-subtitle">{t.manifestoSection.subtitle}</p>
      )
    }
    <p class="paragraph bold">{t.manifestoSection.paragraph1}</p>
    <p class="paragraph">{t.manifestoSection.paragraph2}</p>
    <p class="paragraph">{t.manifestoSection.paragraph3}</p>
    <p class="paragraph bold">{t.manifestoSection.paragraph4}</p>
  </div>
</section>

<style>
  .manifesto-section {
    width: 100%;
    padding: 100px 0 100px 0;
  }

  .content-container {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
    padding: 0 20px;
    position: relative;
  }

  .manifesto-title {
    color: var(--brown);
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 800;
    margin-bottom: 20px;
    line-height: 1.2;
    text-align: center;
  }

  .highlight {
    color: #fffaef;
  }

  .manifesto-subtitle {
    color: var(--brown);
    font-size: clamp(18px, 3vw, 24px);
    font-weight: 600;
    margin-bottom: 40px;
    line-height: 1.3;
    text-align: center;
    font-style: italic;
  }

  .paragraph {
    color: var(--brown);
    line-height: 1.2 !important;
    margin-bottom: 30px;
    font-size: 1rem;
    text-align: center;
  }

  .paragraph.bold {
    font-weight: bold;
  }
  .svg-desktop {
    display: block !important;
  }
  .svg-mobile {
    display: none !important;
  }

  @media (max-width: 768px) {
    .svg-desktop {
      display: none !important;
    }
    .svg-mobile {
      display: block !important;
    }
  }

  @media (max-width: 480px) {
    .svg-desktop {
      display: none !important;
    }
    .svg-mobile {
      display: block !important;
    }
  }
</style>
