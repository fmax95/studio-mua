---
const currentLocale = Astro.currentLocale || "it";
const translations = await import(`../../i18n/${currentLocale}.json`);
const t = translations.default.portfolio;
const projects = [
  { src: "/images/portfolio/project-01.webp", width: 1800, height: 2360 },
  { src: "/images/portfolio/project-02.webp", width: 1800, height: 2700 },
  { src: "/images/portfolio/project-03.webp", width: 1800, height: 2700 },
  { src: "/images/portfolio/project-04.webp", width: 1800, height: 2700 },
  { src: "/images/portfolio/project-05.webp", width: 1800, height: 2700 },
  { src: "/images/portfolio/project-06.webp", width: 1800, height: 2700 },
  { src: "/images/portfolio/project-07.webp", width: 1800, height: 2700 },
  { src: "/images/portfolio/project-08.webp", width: 1023, height: 1537 },
  { src: "/images/portfolio/project-09.webp", width: 1800, height: 2700 },
  { src: "/images/portfolio/project-10.webp", width: 1800, height: 2700 },
  { src: "/images/portfolio/project-11.webp", width: 1800, height: 2700 },
];
---

<main class="portfolio-page">
  <header class="portfolio-heading">
    <h1>{t.pageTitle}</h1>
  </header>

  <section class="gallery" aria-label={t.pageTitle}>
    {
      projects.map((project, index) => (
        <figure class:list={["gallery-item", `gallery-item-${index + 1}`]}>
          <img
            class="gallery-image"
            src={project.src}
            alt={`${t.imageAlt} ${String(index + 1).padStart(2, "0")}`}
            width={project.width}
            height={project.height}
            loading={index < 3 ? "eager" : "lazy"}
            decoding="async"
          />
        </figure>
      ))
    }
  </section>
</main>

<style>
  .portfolio-page {
    min-height: calc(100vh - 100px);
    padding: 54px clamp(20px, 4.8vw, 72px) 80px;
    background: #f8f7f5;
    color: #191919;
  }

  .portfolio-heading {
    max-width: 760px;
    margin: 0 auto 42px;
    text-align: center;
  }

  .portfolio-heading h1 {
    margin: 0 0 8px;
    color: var(--brown);
    font-family: var(--font-title);
    font-size: var(--fs-h1);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .gallery {
    max-width: 1320px;
    margin: 0 auto;
    columns: 3;
    column-gap: 10px;
  }

  .gallery-item {
    position: relative;
    break-inside: avoid;
    margin: 0 0 10px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  .gallery-item-1,
  .gallery-item-5,
  .gallery-item-8 {
    aspect-ratio: 1.12 / 1;
  }

  .gallery-item-2,
  .gallery-item-4,
  .gallery-item-6,
  .gallery-item-9 {
    aspect-ratio: 0.82 / 1;
  }

  .gallery-item-3,
  .gallery-item-7,
  .gallery-item-10,
  .gallery-item-11 {
    aspect-ratio: 1 / 1;
  }

  .gallery-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 820px) {
    .gallery {
      columns: 2;
    }

    .portfolio-heading {
      margin-bottom: 32px;
    }
  }

  @media (max-width: 560px) {
    .portfolio-page {
      padding: 34px 14px 48px;
    }

    .portfolio-heading {
      margin: 0 auto 24px;
      padding: 0 8px;
    }

    .gallery {
      columns: 1;
    }
  }
</style>